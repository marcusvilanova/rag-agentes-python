# Copie para .env e preencha. O arquivo .env está no .gitignore e não deve ser versionado.

# Obrigatória. Chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcionais: sem elas o rastreamento no Langfuse fica desligado.
# Projeto gratuito em https://cloud.langfuse.com (ou uma instância própria).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Valores padrão; descomente para alterar.
# MODELO_CHAT=gemini-3.8-flash
# MODELO_EMBEDDINGS=gemini-embedding-2
# DIMENSOES_EMBEDDINGS=768
# K_TRECHOS=5
# PONTUACAO_MINIMA=0.0
# MAX_TENTATIVAS_REDACAO=2
# CACHE_TTL_SEGUNDOS=86400

# Fora do docker compose, os serviços ficam em localhost.
# MONGODB_URI=mongodb://localhost:27017/?directConnection=true
# REDIS_URL=redis://localhost:6379/0

# Para usar o Milvus no lugar do MongoDB (requer `uv sync --extra milvus`):
# ARMAZENAMENTO=milvus
# MILVUS_URI=http://localhost:19530
